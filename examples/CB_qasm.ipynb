   "## 0.5) QASM Loading and Cycle Construction\n",
   "\n",
   "To adapt the brickwork analysis to an arbitrary algorithm, we replace\n",
   "\"brickwork layers\" with \"algorithm cycles\" (repetitions of the QASM body).\n",
   "\n",
   "The core functions below handle:\n",
   "1. **Loading**: Parsing the QASM and extracting the unitary body.\n",
   "2. **Dressing**: Applying generalized RC (Pauli twirling) to all 2q gates,\n",
   "   and merging Paulis into 1q gates to preserve the pulse count.\n",
   "3. **Repeating**: Constructing the $m$-cycle circuit with frame propagation."
   ],
  },
 {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import random\n",
    "from qiskit import QuantumCircuit\n",
    "from qiskit.quantum_info import Clifford, Pauli\n",
    "\n",
    "def load_algorithm_cycle(qasm_path):\n",
    "    \"\"\"Load a QASM file and extract the unitary body (no measurements/resets).\"\"\"\n",
    "    qc = QuantumCircuit.from_qasm_file(qasm_path)\n",
    "    n_qubits = qc.num_qubits\n",
    "    qc_body = QuantumCircuit(n_qubits)\n",
    "    for instr in qc.data:\n",
    "        if instr.operation.name not in ['measure', 'reset']:\n",
    "            qc_body.append(instr.operation, instr.qubits)\n",
    "    return qc_body\n",
    "\n",
    "def _get_conjugation(gate_op, pauli_str):\n",
    "    \"\"\"P -> letters of G P G^-1 using Clifford evolution.\"\"\"\n",
    "    # pauli_str is 'XY' (q0=X, q1=Y). Qiskit Pauli labels are reversed.\n",
    "    p = Pauli(pauli_str[::-1])\n",
    "    cl = Clifford(gate_op)\n",
    "    out = p.evolve(cl)\n",
    "    # Convert back to our 'q0q1' format\n",
    "    return \"\".join(\"IZXY\"[int(out.x[q]) * 2 + int(out.z[q])] for q in range(len(out.z)))\n",
    "\n",
    "def dress_algorithm_cycle(qc_body, rng, start_frame=None):\n",
    "    \"\"\"Apply generalized RC and merge Paulis into 1q gates to preserve pulse count.\n",
    "    \n",
    "    Returns (dressed_qc, final_frame).\n",
    "    \"\"\"\n",
    "    n_qubits = qc_body.num_qubits\n",
    "    if start_frame is None:\n",
    "        current_frame = [\"I\"] * n_qubits\n",
    "    else:\n",
    "        current_frame = list(start_frame)\n",
    "    \n",
    "    gates = qc_body.data\n",
    "    # Pass 1: Sample twirls for all 2q gates\n",
    "    twirls = {}\n",
    "    for i, g in enumerate(gates):\n",
    "        if len(g.qubits) == 2:\n",
    "            p_pre = \"\".join(rng.choice(_PAULI_1Q) for _ in range(2))\n",
    "            p_post = _get_conjugation(g.operation, p_pre)\n",
    "            twirls[i] = (p_pre, p_post)\n",
    "    \n",
    "    # Pass 2: Build dressed circuit\n",
    "    dressed_qc = QuantumCircuit(n_qubits)\n",
    "    for i, g in enumerate(gates):\n",
    "        if len(g.qubits) == 1:\n",
    "            q = g.qubits[0]\n",
    "            p_in = current_frame[q]\n",
    "            p_out = \"I\"\n",
    "            # Look ahead for the next 2q gate on this qubit\n",
    "            for j in range(i + 1, len(gates)):\n",
    "                if len(gates[j].qubits) == 2 and q in gates[j].qubits:\n",
    "                    # Check if any other 1q gate on q is between i and j\n",
    "                    is_last = True\n",
    "                    for k in range(i + 1, j):\n",
    "                        if len(gates[k].qubits) == 1 and gates[k].qubits[0] == q:\n",
    "                            is_last = False\n",
    "                            break\n",
    "                    if is_last:\n",
    "                        p_out = twirls[j][0][0 if q == gates[j].qubits[0] else 1]\n",
    "                    break\n",
    "            \n",
    "            dressed_qc.append(merged_gate(p_in, g.operation.name, p_out), [q])\n",
    "            current_frame[q] = p_out\n",
    "            \n",
    "        elif len(g.qubits) == 2:\n",
    "            q0, q1 = g.qubits\n",
    "            p_pre, p_post = twirls[i]\n",
    "            # Ensure p_pre is applied if not already absorbed\n",
    "            for q, p_target in zip([q0, q1], p_pre):\n",
    "                if current_frame[q] != p_target:\n",
    "                    dressed_qc.append(merged_gate(current_frame[q], \"id\", p_target), [q])\n",
    "                    current_frame[q] = p_target\n",
    "            \n",
    "            dressed_qc.append(g.operation, [q0, q1])\n",
    "            current_frame[q0] = p_post[0]\n",
    "            current_frame[q1] = p_post[1]\n",
    "            \n",
    "    return dressed_qc, current_frame\n",
    "\n",
    "def build_repeated_algorithm(qc_body, m, rng=None):\n",
    "    \"\"\"Build m repetitions of the algorithm cycle with frame propagation.\"\"\"\n",
    "    if rng is None:\n",
    "        rng = np.random.default_rng()\n",
    "    \n",
    "    n_qubits = qc_body.num_qubits\n",
    "    full_qc = QuantumCircuit(n_qubits)\n",
    "    current_frame = [\"I\"] * n_qubits\n",
    "    \n",
    "    for _ in range(m):\n",
    "        dressed, current_frame = dress_algorithm_cycle(qc_body, rng, start_frame=current_frame)\n",
    "        full_qc.compose(dressed, inplace=True)\n",
    "    \n",
    "    # Trailing layer to absorb the final frame\n",
    "    for q in range(n_qubits):\n",
    "        full_qc.append(merged_gate(current_frame[q], \"id\", \"I\"), [q])\n",
    "        \n",
    "    return full_qc"
   ]
